# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Next.js and Vercel build caches
.next/
out/
.vercel/
/build

# Python automation & mockup render scratchpads
__pycache__/
*.py[cod]
scripts/output_temp/
scripts/*.log

# Scratch / Brain session dumps
.user_uploaded/
*.tmp
scratch/

# misc & OS
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Large media and asset archives
public/media/*.mp4
public/images/**/masters/
