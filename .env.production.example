# ==============================================================================
# KrowN Supply Co. - Production Environment Configuration Template
# ==============================================================================
# BRAND IDENTITIES:
# 1. KrowN Supply Co. (/collections/supply) — Slogan: "WEAR THE KROWN."
# 2. KrowN Construction LLC (/collections/construction) — Slogan: "BUILT TO REIGN."
# 3. AXA / Axiom Allegiance (/collections/gaming) — Slogan: "PLAY TO REIGN."
#
# INSTRUCTIONS:
# Copy this file to `.env.local` or configure these environment variables in
# your production deployment settings (e.g., Vercel Project Settings > Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STRIPE PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
# Where to obtain:
# 1. Log into your Stripe Dashboard: https://dashboard.stripe.com
# 2. Navigate to Developers > API keys: https://dashboard.stripe.com/apikeys
# 3. Toggle off "Test mode" in the top bar to view your Live keys.
# 4. Copy the "Secret key" (starts with `sk_live_...`).
# 5. Copy the "Publishable key" (starts with `pk_live_...`).
STRIPE_SECRET_KEY=sk_live_your_actual_live_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_actual_live_publishable_key_here

# STRIPE WEBHOOK SIGNING SECRET
# Where to obtain:
# 1. Go to Developers > Webhooks: https://dashboard.stripe.com/webhooks
# 2. Click "Add destination" or select your production endpoint:
#    Endpoint URL: https://krownsupply.com/api/webhooks/stripe
# 3. Select events to listen to:
#    - `checkout.session.completed`
#    - `payment_intent.payment_failed`
# 4. Once saved, click "Reveal" under Signing secret (starts with `whsec_...`).
STRIPE_WEBHOOK_SECRET=whsec_your_actual_stripe_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 2. PRINTIFY POD & FULFILLMENT AUTOMATION
# ------------------------------------------------------------------------------
# PRINTIFY API ACCESS TOKEN:
# Where to obtain:
# 1. Log into your Printify Account: https://printify.com
# 2. Click your avatar icon (top right) > "Manage my account" > "API".
#    Direct Link: https://printify.com/app/account/api
# 3. Click "Generate new token".
# 4. Give the token a label (e.g. "KrowN Production Storefront API").
# 5. Check all necessary scopes (Orders, Products, Webhooks) and click "Generate".
# 6. Copy the generated Personal Access Token (PAT).
PRINTIFY_API_KEY=your_printify_personal_access_token_here

# PRINTIFY SHOP ID:
# Where to obtain:
# 1. On your Printify dashboard, look at the URL in your browser or your shop selector:
#    https://printify.com/app/store/products/[SHOP_ID]
# 2. Alternatively, invoke GET https://api.printify.com/v1/shops.json using your API key.
# 3. The Shop ID is the numeric ID (e.g., `12345678`).
PRINTIFY_SHOP_ID=12345678

# ------------------------------------------------------------------------------
# 3. PRODUCTION CANONICAL SITE URL & DOMAIN
# ------------------------------------------------------------------------------
# The fully-qualified canonical domain of your storefront (HTTPS required for Stripe redirects).
# Example: https://krownsupply.com
NEXT_PUBLIC_SITE_URL=https://krownsupply.com

# ------------------------------------------------------------------------------
# 4. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
